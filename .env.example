# Copia este archivo como .env.local para cambiar la configuración.

# URL de una API REST real. Vacía = se usa la API simulada del navegador (src/mocks).
VITE_API_URL=

# Probabilidad (0 a 1) de que la API simulada falle con un 503. Sirve para probar rollbacks y reintentos.
VITE_MOCK_FAILURE_RATE=0.1

# Latencia simulada en milisegundos.
VITE_MOCK_LATENCY_MIN=400
VITE_MOCK_LATENCY_MAX=1100
